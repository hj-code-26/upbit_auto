# ── OKX API ───────────────────────────────────────────────────────────
# 실계좌 키: okx.com > 프로필 > API > 생성. 권한 '거래' 만, 출금은 절대 체크하지 말 것. IP 화이트리스트 권장.
# 실계좌 전용 — OKX 데모(모의투자)는 2026-09-28 제외. 주문이 나가는지는 MODE 가 정한다 (live 면 시작 시 '실주문' 입력).
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
SYMBOL=BTC/USDT:USDT           # USDT 무기한 선물
# ── 실행 모드 ─────────────────────────────────────────────────────────
MODE=paper                     # paper: 모의 장부만 | live: 매 주문 거래소로 | auto: 모의 장부 N회 완료 후 거래소 주문
LIVE_AFTER_PAPER_TRADES=2      # auto 모드에서 거래소 주문으로 넘어가는 모의 장부 거래(진입→청산) 완료 횟수
PAPER_CASH=1000                # 모의 장부 시작 자산 (USDT)
POSITION_PCT=100               # 자산 중 포지션 증거금으로 쓰는 비율
LEVERAGE=1                     # 급락 매수는 1배. 코드 상한 2 (autotrade.MAX_LEVERAGE)
                               # research/aoa/dip_lev2.py: 2배는 BitMEX 2018-21 MDD −63% 로 사전등록 불합격
MAX_DAY_LOSS_PCT=15            # 24h 고점 대비 이만큼 빠지면 청산 + 자동실행 정지 (재개: make on). 0 = 끄기
                               # 1배·손절 −6% 라 하루 −15% 는 손절이 작동하지 않은 것 (버그·급변)
INTERVAL_MIN=5                 # 판단 주기(분). 5분봉 마감 15초 뒤마다. 늘리면 그 사이 봉의 진입 신호를 놓친다
DASHBOARD_PORT=8000
# ── Claude 검토 (매수 직전, OmniRoute 경유. CLAUDE_BASE_URL 비우면 정량 신호만으로 매매) ──
CLAUDE_BASE_URL=http://localhost:20128   # OmniRoute (make run 이 자동 기동). Anthropic 호환 /v1/messages
CLAUDE_MODEL=claude/claude-opus-5            # OmniRoute 모델명. auto/ 는 Claude 제공자가 없으면 다른 모델로 조용히 대체되니 고정한다
