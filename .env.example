# ── OKX API (서버에서 직접 설정. 출금 권한 없이, IP 제한으로 발급) ───────────────
# 계정 설정: 선물 거래 가능한 계정 모드 + 포지션 모드 = long/short(헤지). net(단방향)이면 봇이 실행을 거부한다.
# 포지션 모드는 포지션이 없을 때만 바꿀 수 있다. 데모 키는 데모 거래 화면에서 따로 발급한다.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# ── 실행 모드 (명시적으로만 전환) ─────────────────────────────────────────
MODE=dry                       # dry: 주문 없이 장부만 (기본) → demo: OKX 데모 거래 → live: 실거래
PAPER_EQUITY_USDT=10000        # dry 장부 시작 자산
# OKX_BALANCE_DEMO=1          # dry 에서 잔액 표시를 데모 계정 키로 할 때 (기본: 실계정 잔액만 조회, 주문 없음)
# ALERT_WEBHOOK_URL=           # 경보 (Slack/Discord 웹훅). 없으면 로그(autotrade.log)에만 남는다
# ── 시각 분할·위험 감시 ─────────────────────────────────────────────────
# RLSC_TRANCHES=0,4,8,12,16,20 # 몫 경계 UTC 시 (기본 6몫). 열린 몫이 있으면 바꿔도 시작하지 않는다. 0 = 1몫. 값이 바뀌면 설정 해시가 바뀌고 다른 백테스트가 기준이 된다
# RLSC_MARGIN=0.04             # 종목당 증거금 비율 (기본 4%, 실현 잔고 대비, 몫당 = 비율/몫 수). 0 초과 0.05 이하. 소액 계좌가 BTC 최소 주문을
#                               # 맞추려면 올린다 — 위험(낙폭)도 거의 같은 비율로 커진다. 필요한 값은 --preflight 가 알려 준다
# RLSC_VOL_TARGET=0.04         # 동적 크기: 진입 증거금 × clip(목표 / ATR%, 0.5, 2). 0 = 끔 (고정 크기). ETH 단독에서 개선, BTC+ETH 6몫은 끄는 편이 낫다
# RLSC_RISK_POLL_SEC=5          # 위험 감시 간격 초 (기본 demo/live 5, dry 60)
# RLSC_PROTECT_SEC=60           # 위험 감시 중 대사·손절 점검 간격 초
