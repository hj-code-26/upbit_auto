# ── 업비트 Open API ────────────────────────────────────────────────────
# upbit.com 로그인 > 우측 상단 프로필 > Open API 관리 > 자산조회 / 주문조회 / 주문하기 체크
# (출금은 절대 체크하지 말 것) > 이 PC 의 공인 IP 등록 > 발급.  Secret Key 는 발급 화면에서만 보인다.
# 조건: 실명확인 입출금 계좌(케이뱅크) 등록 + 카카오 인증 완료 계정만 API 발급 가능.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
SYMBOL=KRW-BTC
# ── 실행 모드 ─────────────────────────────────────────────────────────
MODE=auto                      # paper: 모의만 | live: 매 주문 실주문 | auto: 모의 거래 N회 완료 후 실주문 (기본)
LIVE_AFTER_PAPER_TRADES=2      # auto 모드에서 실주문으로 넘어가는 모의 거래(진입→청산) 완료 횟수
PAPER_CASH_KRW=1000000         # 모의 장부 시작 자산 (원)
POSITION_PCT=100               # 자산 중 포지션에 쓰는 비율. 현물이라 레버리지 없음
TRADE_TIME=09:05               # 업비트 일봉 경계(09:00 KST) 직후 = 백테스트의 '다음날 시가' 체결
# ── Claude 거부권 (비우면 정량 신호만으로 매매) ────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=          # OmniRoute 등 게이트웨이 경유 시
# SERPAPI_API_KEY=             # 뉴스 헤드라인 (선택)
