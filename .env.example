# ── OKX API ───────────────────────────────────────────────────────────
# 데모(모의투자) 키: okx.com 로그인 > 우측 상단 '모의투자(Demo Trading)' 진입 > 프로필 > API > 생성. 권한: 읽기 + 거래 (출금 없음)
# 실계좌 키: okx.com > 프로필 > API > 생성. 권한 '거래' 만, 출금은 절대 체크하지 말 것. IP 화이트리스트 권장.
# 데모 키와 실계좌 키는 다르다. OKX_DEMO 값에 맞는 키를 넣어라.
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
# 데모 주문(대시보드 '데모 매수/매도')용 모의투자 전용 키. 없으면 데모 버튼만 잠긴다
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET=
OKX_DEMO_PASSPHRASE=
OKX_DEMO=0                     # 1: 모의투자 서버(가짜 돈, 기본) | 0: 실계좌(진짜 돈, 시작 시 '실주문' 타이핑 필요)
SYMBOL=BTC/USDT:USDT           # USDT 무기한 선물
# ── 실행 모드 ─────────────────────────────────────────────────────────
MODE=paper                      # paper: 모의 장부만 | live: 매 주문 거래소로 | auto: 모의 장부 N회 완료 후 거래소 주문 (기본)
LIVE_AFTER_PAPER_TRADES=2      # auto 모드에서 거래소 주문으로 넘어가는 모의 장부 거래(진입→청산) 완료 횟수
PAPER_CASH=1000                # 모의 장부 시작 자산 (USDT)
POSITION_PCT=100               # 자산 중 포지션 증거금으로 쓰는 비율
LEVERAGE=3                     # 격리 마진 레버리지. 명목 = 자산 × POSITION_PCT × LEVERAGE. 손실이 증거금에 닿으면 청산
                               # 코드 상한 5배 (autotrade.MAX_LEVERAGE). 넘기면 봇이 시작하지 않는다.
                               # backtest_current.py --lev: 고정 5배까지 생존(+2,359%/MDD -59%), 7배부터 전액 청산
EXTREME_MIN=0                  # 진입에 요구하는 4h 극단 점수(0~7) 하한. 0 = 끔
                               # 2 로 두면 '과열되어 보이는 돌파' 에만 들어간다. RSI 과열·밴드 이탈은 이후 수익률을 낮추지 않는다
                               # research_reversion.txt: OKX 12설정 중 11개 개선(검증 Sharpe 1.29->1.35)이나
                               # 10년 Bitstamp 표본에선 개선 없음. research_bias.txt 의 비판적 검증에서는
                               # 다중 검정 보정 시 실효 p ~= 0.30 이고, 7규칙 중 1개(볼린저)만 일하고
                               # 1개(도치안)는 해로운 것으로 나왔다 → **0 권장**
ALLOW_SHORT=0                  # 숏(하락 베팅) 실주문 허용. 0 이어도 숏 자리는 계산·기록·표시된다
                               # research_both_sides.txt: 숏만 1배 -72%, 롱+숏 1배 -34% (롱만 +135%) → 기본 꺼짐
VOL_TARGET_PCT=40              # 변동성 타겟. 계좌 일별 실현변동성(연율)이 이 값을 넘으면 그만큼 레버리지를 깎는다
                               # lev = min(LEVERAGE, VOL_TARGET_PCT / 실현변동성). 올리지는 않는다. 0 = 끄기
                               # research_quant_transfer.txt: MDD -42.5%->-22.4%, Sharpe(검증) 0.80->1.29
VOL_WINDOW=40                  # 실현 변동성 창 (일). 자산 이력이 절반(20일) 쌓여야 켜지고, 그전엔 LEVERAGE 그대로
                               # 25조합 스윕에서 창 40일이 30/60/90/120 보다 나았다 (검증 Sharpe 1.29)
MAX_DAY_LOSS_PCT=40            # 24h 고점 대비 이만큼 빠지면 청산 + 자동실행 정지 (재개: make on). 0 = 끄기
                               # 전략이 정상으로 내는 24h 낙폭보다 넉넉히 위여야 한다 (3배 -21% / 5배 -29.9%)
ENTRY_FLOOR=1                  # 1: 돌파당한 고가를 하한으로 보고, 분봉이 그 선을 지키거나 되찾을 때만 매수
                               #    다음 4h 봉까지 못 지키면 자리 포기 (research_entry_timing.txt: 3배 +1,286% vs 즉시매수 +558%)
                               # 0: 신호 나면 즉시 매수 (예전 동작)
INTERVAL_MIN=10                # 판단 주기(분). 국면은 일봉(09:00 KST), 진입·청산은 4h 봉 마감(01·05·09·13·17·21시 KST) 뒤 이 시간 안에
DASHBOARD_PORT=8000
# ── 업비트 (정리용, liquidate_upbit.py 만 읽는다. 정리 끝나면 지우고 upbit.com 에서 키도 삭제) ──
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# ── Claude 검토 (매수 직전, OmniRoute 경유. CLAUDE_BASE_URL 비우면 정량 신호만으로 매매) ──
CLAUDE_BASE_URL=http://localhost:20128   # OmniRoute (make run 이 자동 기동). Anthropic 호환 /v1/messages
CLAUDE_MODEL=claude/claude-opus-5            # OmniRoute 모델명. auto/ 는 Claude 제공자가 없으면 다른 모델로 조용히 대체되니 고정한다
